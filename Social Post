<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>SPS Fitness Content Studio</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
:root {
  --black:#000;--surface:#0d0d0d;--surface2:#161616;--surface3:#202020;
  --border:rgba(255,255,255,0.07);--border2:rgba(255,255,255,0.14);
  --blue:#1a6fff;--blue2:#3d8bff;--blue3:#1050cc;
  --cyan:#00e5ff;--green:#39d98a;--gold:#ffb800;
  --text:#f0f0f0;--muted:rgba(255,255,255,0.45);--faint:rgba(255,255,255,0.18);
  --r:14px;--rs:9px;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--black);color:var(--text);font-family:'DM Sans',sans-serif;font-size:15px;min-height:100vh;}
.header{height:62px;background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 28px;position:sticky;top:0;z-index:200;}
.logo{font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:3px;color:#fff;}
.logo span{color:var(--blue2);}
.pill{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:600;padding:6px 14px;border-radius:20px;}
.pill.off{background:var(--surface3);color:var(--muted);}
.pill.on{background:rgba(57,217,138,0.12);color:var(--green);border:1px solid rgba(57,217,138,0.25);}
.dot{width:7px;height:7px;border-radius:50%;}
.pill.off .dot{background:var(--faint);}
.pill.on .dot{background:var(--green);box-shadow:0 0 7px var(--green);}
.app{display:flex;min-height:calc(100vh - 62px);}
.sidebar{width:210px;flex-shrink:0;background:var(--surface);border-right:1px solid var(--border);padding:20px 0;}
.ns{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--faint);padding:18px 24px 7px;}
.ni{display:flex;align-items:center;gap:11px;padding:11px 24px;font-size:14px;font-weight:500;color:var(--muted);cursor:pointer;border-left:3px solid transparent;transition:all .15s;user-select:none;}
.ni:hover{color:var(--text);background:rgba(255,255,255,0.03);}
.ni.active{color:#fff;border-left-color:var(--blue2);background:rgba(26,111,255,0.1);}
.ni svg{width:17px;height:17px;flex-shrink:0;stroke:currentColor;fill:none;stroke-width:2;}
.nb{margin-left:auto;background:var(--blue);color:#fff;font-size:10px;font-weight:700;padding:2px 7px;border-radius:10px;min-width:18px;text-align:center;}
.main{flex:1;padding:36px;overflow-y:auto;max-width:900px;}
.panel{display:none;}
.panel.active{display:block;}
.pt{font-family:'Bebas Neue',sans-serif;font-size:38px;letter-spacing:2px;line-height:1;margin-bottom:4px;color:#fff;}
.pt span{color:var(--blue2);}
.ps{font-size:14px;color:var(--muted);margin-bottom:24px;}
.al{height:2px;background:linear-gradient(90deg,var(--blue),var(--cyan));border-radius:2px;margin-bottom:28px;opacity:.6;}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:24px;margin-bottom:16px;}
.cl{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:12px;}
.tg{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:20px;}
.tb{padding:18px 8px 14px;border:1px solid var(--border);border-radius:var(--rs);background:var(--surface2);cursor:pointer;text-align:center;transition:all .15s;color:var(--muted);}
.tb:hover{border-color:var(--border2);color:var(--text);transform:translateY(-1px);}
.ti{font-size:26px;margin-bottom:7px;}
.tl{font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;}
.tb[data-type="motivation"].sel{border-color:var(--blue);background:rgba(26,111,255,0.14);color:#fff;}
.tb[data-type="myth"].sel{border-color:var(--cyan);background:rgba(0,229,255,0.1);color:#fff;}
.tb[data-type="evidence"].sel{border-color:var(--green);background:rgba(57,217,138,0.1);color:#fff;}
.tb[data-type="quickwin"].sel{border-color:var(--gold);background:rgba(255,184,0,0.1);color:#fff;}
input,textarea{width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:var(--rs);color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;padding:12px 16px;outline:none;transition:border-color .15s;}
input:focus,textarea:focus{border-color:var(--blue2);}
input::placeholder,textarea::placeholder{color:var(--faint);}
textarea{min-height:50px;resize:vertical;line-height:1.75;}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:11px 18px;border-radius:var(--rs);font-family:'DM Sans',sans-serif;font-size:13px;font-weight:600;cursor:pointer;transition:all .15s;border:none;letter-spacing:.02em;white-space:nowrap;}
.bp{background:var(--blue);color:#fff;width:100%;font-family:'Bebas Neue',sans-serif;font-size:19px;letter-spacing:3px;padding:14px;box-shadow:0 0 30px rgba(26,111,255,0.3);}
.bp:hover{background:var(--blue2);box-shadow:0 0 40px rgba(61,139,255,0.45);transform:translateY(-1px);}
.bg{background:var(--surface2);color:var(--muted);border:1px solid var(--border);}
.bg:hover{color:var(--text);border-color:var(--border2);background:var(--surface3);}
.bc{background:rgba(0,229,255,0.12);color:var(--cyan);border:1px solid rgba(0,229,255,0.25);}
.bc:hover{background:rgba(0,229,255,0.2);}
.bgreen{background:rgba(57,217,138,0.12);color:var(--green);border:1px solid rgba(57,217,138,0.25);}
.bgreen:hover{background:rgba(57,217,138,0.2);}
.br{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px;}
.pb{background:var(--surface2);border:1px solid var(--border);border-radius:var(--rs);padding:20px;font-size:15px;line-height:1.8;color:var(--text);white-space:pre-wrap;min-height:100px;}
.pb.loading{color:var(--faint);font-style:italic;}
.sb{padding:12px 16px;border-radius:var(--rs);font-size:13px;font-weight:500;margin-top:12px;display:none;}
.sb.success{background:rgba(57,217,138,0.1);color:var(--green);border:1px solid rgba(57,217,138,0.2);}
.sb.error{background:rgba(255,80,80,0.1);color:#ff6b6b;border:1px solid rgba(255,80,80,0.2);}
.sb.info{background:rgba(26,111,255,0.1);color:var(--blue2);border:1px solid rgba(26,111,255,0.2);}
.sf{background:var(--surface2);border:1px solid var(--border);border-radius:var(--rs);padding:20px;margin-top:14px;display:none;}
.sr{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;}
.sl{font-size:13px;font-weight:600;color:var(--text);margin-bottom:6px;}
.sh{font-size:12px;color:var(--faint);margin-top:5px;line-height:1.55;}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:24px;}
.sc{background:var(--surface);border:1px solid var(--border);border-radius:var(--rs);padding:18px 20px;}
.sn{font-family:'Bebas Neue',sans-serif;font-size:36px;line-height:1;margin-bottom:4px;}
.sk{font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);}
.qi{background:var(--surface);border:1px solid var(--border);border-radius:var(--rs);padding:16px;margin-bottom:10px;display:flex;align-items:flex-start;gap:14px;transition:border-color .15s;}
.qi:hover{border-color:var(--border2);}
.qicon{width:42px;height:42px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;}
.qb{flex:1;min-width:0;}
.qp{font-size:13px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:4px;}
.qt{font-size:11px;color:var(--faint);margin-top:5px;display:flex;align-items:center;gap:5px;}
.qa{display:flex;gap:6px;margin-top:9px;}
.qa .btn{padding:5px 12px;font-size:12px;}
.qdel{background:none;border:none;color:var(--faint);cursor:pointer;padding:2px 4px;font-size:22px;line-height:1;flex-shrink:0;transition:color .15s;}
.qdel:hover{color:#ff6b6b;}
.badge{display:inline-flex;align-items:center;font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:3px 8px;border-radius:4px;}
.bm{background:rgba(26,111,255,0.2);color:var(--blue2);}
.bmyth{background:rgba(0,229,255,0.15);color:var(--cyan);}
.be{background:rgba(57,217,138,0.15);color:var(--green);}
.bq{background:rgba(255,184,0,0.15);color:var(--gold);}
.bdue{background:rgba(255,184,0,0.15);color:var(--gold);}
.cnr{display:flex;align-items:center;gap:12px;margin-bottom:18px;}
.cnb{background:var(--surface2);border:1px solid var(--border);color:var(--text);padding:8px 16px;border-radius:var(--rs);cursor:pointer;font-size:16px;transition:all .15s;}
.cnb:hover{border-color:var(--blue2);color:var(--blue2);}
.crl{font-family:'Bebas Neue',sans-serif;font-size:24px;letter-spacing:2px;flex:1;text-align:center;color:#fff;}
.cgrid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;}
.cdh{font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--faint);text-align:center;padding:5px 0;}
.cc{min-height:72px;background:var(--surface);border:1px solid var(--border);border-radius:var(--rs);padding:8px;transition:all .15s;}
.cc.hp{border-color:rgba(26,111,255,0.35);background:rgba(26,111,255,0.06);}
.cc.td{border-color:var(--blue2);box-shadow:0 0 12px rgba(26,111,255,0.2);}
.cn{font-size:13px;font-weight:600;margin-bottom:5px;color:var(--muted);}
.cc.td .cn{color:var(--blue2);}
.cdot{width:8px;height:8px;border-radius:50%;margin:2px 0;}
.cdot.motivation{background:var(--blue);}
.cdot.myth{background:var(--cyan);}
.cdot.evidence{background:var(--green);}
.cdot.quickwin{background:var(--gold);}
.cleg{display:flex;gap:18px;flex-wrap:wrap;margin-top:16px;}
.cli{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);}
.empty{text-align:center;padding:52px 24px;color:var(--faint);}
.empty p{font-size:14px;line-height:1.6;margin-top:12px;}
.hs{display:flex;gap:12px;margin-bottom:14px;align-items:flex-start;}
.hn{width:28px;height:28px;border-radius:50%;background:var(--blue);color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0;margin-top:1px;}
.ht{font-size:13px;color:var(--muted);line-height:1.6;}
.ht strong{color:var(--text);}
.ht a{color:var(--blue2);text-decoration:none;}
.ht a:hover{text-decoration:underline;}
.img-box{margin-top:16px;display:none;}
.img-box img{width:100%;border-radius:var(--rs);border:1px solid var(--border);display:block;}
.img-loading{background:var(--surface2);border:1px solid var(--border);border-radius:var(--rs);padding:20px;text-align:center;color:var(--faint);font-size:13px;}
@media(max-width:680px){.sidebar{display:none;}.tg{grid-template-columns:repeat(2,1fr);}.stats{grid-template-columns:1fr 1fr;}.main{padding:20px 16px 48px;}.pt{font-size:28px;}}
</style>
</head>
<body>

<header class="header">
  <div class="logo">SPS <span>FITNESS</span></div>
  <div class="pill off" id="connPill">
    <div class="dot"></div>
    <span id="connLabel">Not connected</span>
  </div>
</header>

<div class="app">
  <nav class="sidebar">
    <div class="ns">Content</div>
    <div class="ni active" id="nav-generate" onclick="showPanel('generate')">
      <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      Generate
    </div>
    <div class="ni" id="nav-queue" onclick="showPanel('queue')">
      <svg viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
      Queue <span class="nb" id="queueBadge">0</span>
    </div>
    <div class="ni" id="nav-calendar" onclick="showPanel('calendar')">
      <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
      Calendar
    </div>
    <div class="ns">App</div>
    <div class="ni" id="nav-settings" onclick="showPanel('settings')">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
      Settings
    </div>
  </nav>

  <main class="main">

    <div class="panel active" id="panel-generate">
      <div class="pt">Create a <span>post</span></div>
      <div class="ps">AI-written content for your over 30s fitness community</div>
      <div class="al"></div>
      <div class="card">
        <div class="cl">Post type</div>
        <div class="tg">
          <div class="tb sel" data-type="motivation" onclick="selectType(this)"><div class="ti">&#x1F525;</div><div class="tl">Motivation</div></div>
          <div class="tb" data-type="myth" onclick="selectType(this)"><div class="ti">&#x1F4A1;</div><div class="tl">Myth bust</div></div>
          <div class="tb" data-type="evidence" onclick="selectType(this)"><div class="ti">&#x1F52C;</div><div class="tl">Evidence</div></div>
          <div class="tb" data-type="quickwin" onclick="selectType(this)"><div class="ti">&#x26A1;</div><div class="tl">Quick win</div></div>
        </div>
        <div class="cl">Focus <span style="font-weight:400;text-transform:none;font-size:12px;color:var(--faint)">(optional)</span></div>
        <input type="text" id="extraCtx" placeholder="e.g. Monday energy, sleep, protein..." style="margin-bottom:18px" />
        <button class="btn bp" id="genBtn" onclick="generatePost()">&#x2726; GENERATE POST</button>
      </div>

      <div class="card" id="outputCard" style="display:none">
        <div class="cl">Your post</div>
        <div class="pb" id="postOutput"></div>
        <div class="img-box" id="imgBox">
          <div class="cl" style="margin-top:16px;margin-bottom:8px">Suggested image</div>
          <div id="imgContent"></div>
          <div class="br" style="margin-top:8px">
            <button class="btn bg" onclick="fetchImage()">&#x21BA; New image</button>
            <a id="imgDownload" class="btn bc" style="text-decoration:none" download="sps-post-image.jpg">&#x2913; Download image</a>
          </div>
        </div>
        <div class="br">
          <button class="btn bg" onclick="generatePost()">&#x21BA; Regenerate</button>
          <button class="btn bg" onclick="editPost()">&#x270E; Edit</button>
          <button class="btn bc" onclick="openSchedForm()">&#x1F4C5; Schedule</button>
          <button class="btn bg" onclick="copyPost()">&#x2398; Copy</button>
        </div>
        <div class="sb" id="outputStatus"></div>
      </div>

      <div class="sf" id="schedForm">
        <div class="cl" style="margin-bottom:14px">Schedule this post</div>
        <div class="sr">
          <div><div class="sl">Date</div><input type="date" id="schedDate" /></div>
          <div><div class="sl">Time</div><input type="time" id="schedTime" value="09:00" /></div>
        </div>
        <div style="display:flex;gap:8px">
          <button class="btn bgreen" style="flex:1" onclick="addToQueue()">&#x2713; Add to queue</button>
          <button class="btn bg" onclick="closeSchedForm()">Cancel</button>
        </div>
      </div>
    </div>

    <div class="panel" id="panel-queue">
      <div class="pt">Scheduled <span>queue</span></div>
      <div class="ps">Copy each post into Meta Business Suite to schedule it</div>
      <div class="al"></div>
      <div class="stats">
        <div class="sc"><div class="sn" id="statTotal" style="color:var(--blue2)">0</div><div class="sk">Scheduled</div></div>
        <div class="sc"><div class="sn" id="statDue" style="color:var(--gold)">0</div><div class="sk">Due now</div></div>
        <div class="sc"><div class="sn" id="statWeek" style="color:var(--cyan)">0</div><div class="sk">This week</div></div>
      </div>
      <div class="br" style="margin-bottom:20px">
        <button class="btn bp" style="flex:1" onclick="generateWeek()">&#x2726; AUTO-FILL NEXT 7 DAYS</button>
        <button class="btn bg" onclick="clearQueue()">&#x1F5D1; Clear all</button>
      </div>
      <div class="sb" id="queueStatus" style="margin-bottom:12px"></div>
      <div id="queueList"></div>
    </div>

    <div class="panel" id="panel-calendar">
      <div class="pt">Content <span>calendar</span></div>
      <div class="ps">Your weekly content at a glance</div>
      <div class="al"></div>
      <div class="cnr">
        <button class="cnb" onclick="shiftWeek(-1)">&#x2039;</button>
        <div class="crl" id="calRange"></div>
        <button class="cnb" onclick="shiftWeek(1)">&#x203A;</button>
      </div>
      <div class="cgrid" id="calGrid"></div>
      <div class="cleg">
        <div class="cli"><div class="cdot motivation"></div>Motivation</div>
        <div class="cli"><div class="cdot myth"></div>Myth busting</div>
        <div class="cli"><div class="cdot evidence"></div>Evidence based</div>
        <div class="cli"><div class="cdot quickwin"></div>Quick win</div>
      </div>
    </div>

    <div class="panel" id="panel-settings">
      <div class="pt">Settings</div>
      <div class="ps">Connect your Facebook page and configure defaults</div>
      <div class="al"></div>
      <div class="card">
        <div class="cl">Facebook page connection</div>
        <div style="margin-bottom:16px">
          <div class="sl">Page access token</div>
          <input type="password" id="fbToken" placeholder="Paste your Page Access Token..." />
          <div class="sh">Graph API Explorer &rarr; User or Page &rarr; select your page name</div>
        </div>
        <div style="margin-bottom:18px">
          <div class="sl">Page ID</div>
          <input type="text" id="fbPageId" placeholder="e.g. 10154224424799682" />
          <div class="sh">Facebook Page &rarr; About &rarr; scroll to bottom</div>
        </div>
        <button class="btn bp" style="max-width:280px" onclick="saveAndTest()">SAVE &amp; TEST CONNECTION</button>
        <div class="sb" id="settingsStatus"></div>
      </div>
      <div class="card">
        <div class="cl">Default post time</div>
        <input type="time" id="defaultTime" value="09:00" style="max-width:180px;margin-bottom:6px" />
        <div class="sh">Auto-fill posts will use this time daily</div>
      </div>
      <div class="card">
        <div class="cl">How to publish posts</div>
        <div class="hs"><div class="hn">1</div><div class="ht">Generate your post and click <strong>Copy</strong></div></div>
        <div class="hs"><div class="hn">2</div><div class="ht">Go to <a href="https://business.facebook.com" target="_blank">business.facebook.com</a> &rarr; <strong>Planner</strong> &rarr; <strong>Create post</strong></div></div>
        <div class="hs"><div class="hn">3</div><div class="ht">Paste, click the arrow next to "Post now" &rarr; <strong>Schedule</strong> &rarr; pick date and time</div></div>
        <div class="hs"><div class="hn">4</div><div class="ht">Use <strong>Auto-fill 7 days</strong> to batch your whole week every Monday — takes about 10 minutes</div></div>
      </div>
    </div>

  </main>
</div>

<script>
var SYS = "You are a content writer for an over-30s women's fitness Facebook page in the UK called SPS Fitness. Tone: bold, warm, straight-talking, never condescending, never preachy, never toxic-positive. These are busy women with full lives. Posts feel like a knowledgeable friend not a coach lecturing. Under 200 words. Punchy and conversational. End with an engaging question or CTA. Max 3 hashtags. Never say ladies, girls, you need to, or you should. Use we or you warmly. British English.";

var PROMPTS = {
  motivation: function(c) { return "Write a motivational post" + (c ? " focused on: " + c : "") + ". Real and grounding, not cheesy. Acknowledge busy lives. Celebrate small wins. Reference relatable scenarios like hectic weeks or fitting movement around a packed schedule."; },
  myth: function(c) { return "Write a myth-busting post" + (c ? " about: " + c : "") + ". Pick one fitness myth affecting women over 30 such as lifting makes you bulky, you need an hour minimum, or cardio is the only way to lose weight. Bust it with a punchy evidence-backed explanation."; },
  evidence: function(c) { return "Write an evidence-based post" + (c ? " about: " + c : "") + ". One science-backed insight for women over 30 such as strength training and bone density, sleep and recovery, hormones and exercise, or protein and muscle retention. Interesting and accessible, no jargon."; },
  quickwin: function(c) { return "Write a quick win post" + (c ? " about: " + c : "") + ". One practical tip a busy woman could do today. Under 10 minutes, no equipment needed, fits into existing routine. Think habit stacking, desk stretches, protein swaps. Doable not overwhelming."; }
};

var CYCLE = ["motivation","myth","evidence","quickwin","motivation","myth","quickwin"];
var BADGE = { motivation:"bm", myth:"bmyth", evidence:"be", quickwin:"bq" };
var ICONS = { motivation:"&#x1F525;", myth:"&#x1F4A1;", evidence:"&#x1F52C;", quickwin:"&#x26A1;" };
var IBGS = { motivation:"rgba(26,111,255,0.15)", myth:"rgba(0,229,255,0.12)", evidence:"rgba(57,217,138,0.1)", quickwin:"rgba(255,184,0,0.12)" };
var IMG_QUERIES = { motivation:"woman fitness workout motivation", myth:"fitness myth strength training women", evidence:"women strength training science", quickwin:"quick workout busy women" };

var selType = "motivation";
var curPost = "";
var queue = [];
var calOff = 0;

function showPanel(name) {
  var panels = document.querySelectorAll(".panel");
  for (var i = 0; i < panels.length; i++) panels[i].classList.remove("active");
  var navs = document.querySelectorAll(".ni");
  for (var i = 0; i < navs.length; i++) navs[i].classList.remove("active");
  document.getElementById("panel-" + name).classList.add("active");
  document.getElementById("nav-" + name).classList.add("active");
  if (name === "calendar") renderCalendar();
  if (name === "queue") renderQueue();
}

function selectType(el) {
  var btns = document.querySelectorAll(".tb");
  for (var i = 0; i < btns.length; i++) btns[i].classList.remove("sel");
  el.classList.add("sel");
  selType = el.getAttribute("data-type");
}

function generatePost() {
  var ctx = document.getElementById("extraCtx").value.trim();
  var card = document.getElementById("outputCard");
  var out = document.getElementById("postOutput");
  var imgBox = document.getElementById("imgBox");
  card.style.display = "block";
  document.getElementById("schedForm").style.display = "none";
  imgBox.style.display = "none";
  hideStatus("outputStatus");
  out.className = "pb loading";
  out.textContent = "Writing your post...";
  fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: { "Content-Type": "application/json",
    "x-api-key": "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",
    "anthropic-version": "2023-06-01",
    "anthropic-dangerous-direct-browser-access": "true" },
    body: JSON.stringify({ model: "claude-sonnet-4-20250514", max_tokens: 1000, system: SYS, messages: [{ role: "user", content: PROMPTS[selType](ctx) }] })
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.error) throw new Error(d.error.message);
    curPost = d.content.map(function(b) { return b.text || ""; }).join("").trim();
    out.className = "pb";
    out.textContent = curPost;
    fetchImage();
  })
  .catch(function(e) {
    out.className = "pb";
    out.textContent = "Could not generate post. Please try again.";
  });
}

function fetchImage() {
  var imgBox = document.getElementById("imgBox");
  var imgContent = document.getElementById("imgContent");
  imgBox.style.display = "block";
  imgContent.innerHTML = '<div class="img-loading">Finding a matching image...</div>';
  var query = encodeURIComponent(IMG_QUERIES[selType] || "fitness women workout");
  var url = "https://api.unsplash.com/photos/random?query=" + query + "&orientation=landscape&client_id=your_unsplash_key";
  fetch(url)
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.errors || !d.urls) throw new Error("No image");
    var imgUrl = d.urls.regular;
    imgContent.innerHTML = '<img src="' + imgUrl + '" alt="Post image" />';
    var dl = document.getElementById("imgDownload");
    dl.href = d.urls.full;
    dl.style.display = "inline-flex";
  })
  .catch(function() {
    var fallback = "https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=800&q=80";
    imgContent.innerHTML = '<img src="' + fallback + '" alt="Fitness image" />';
    var dl = document.getElementById("imgDownload");
    dl.href = fallback;
    dl.style.display = "inline-flex";
  });
}

function editPost() {
  var out = document.getElementById("postOutput");
  var ta = document.createElement("textarea");
  ta.value = out.textContent || out.value || "";
  ta.className = "pb";
  ta.id = "postOutput";
  ta.addEventListener("input", function() { curPost = ta.value; });
  out.parentNode.replaceChild(ta, out);
}

function getPostText() {
  var el = document.getElementById("postOutput");
  return el.value !== undefined ? el.value : el.textContent;
}

function openSchedForm() {
  if (!curPost) return;
  document.getElementById("schedForm").style.display = "block";
  var today = new Date().toISOString().split("T")[0];
  document.getElementById("schedDate").value = today;
  var t = document.getElementById("defaultTime");
  document.getElementById("schedTime").value = t ? t.value : "09:00";
}

function closeSchedForm() {
  document.getElementById("schedForm").style.display = "none";
}

function addToQueue() {
  var date = document.getElementById("schedDate").value;
  var time = document.getElementById("schedTime").value;
  if (!date || !time || !curPost) return;
  queue.push({ id: Date.now(), type: selType, text: curPost, date: date, time: time });
  queue.sort(function(a,b) { return (a.date+a.time).localeCompare(b.date+b.time); });
  closeSchedForm();
  updateBadge();
  showStatus("outputStatus", "Added to queue for " + fmtDate(date) + " at " + time, "success");
  setTimeout(function() { hideStatus("outputStatus"); }, 3000);
}

function removeFromQueue(id) {
  queue = queue.filter(function(q) { return q.id !== id; });
  renderQueue();
  updateBadge();
}

function copyPost() {
  var t = getPostText();
  if (!t) return;
  navigator.clipboard.writeText(t).then(function() {
    showStatus("outputStatus", "Copied! Now paste into Meta Business Suite.", "success");
    setTimeout(function() { hideStatus("outputStatus"); }, 3000);
  });
}

function copyQueueItem(id) {
  var item = null;
  for (var i = 0; i < queue.length; i++) { if (queue[i].id === id) { item = queue[i]; break; } }
  if (!item) return;
  navigator.clipboard.writeText(item.text).then(function() {
    alert("Copied!\n\nGo to business.facebook.com > Planner > Create post > paste > Schedule");
  });
}

function renderQueue() {
  var list = document.getElementById("queueList");
  var now = new Date();
  var weekEnd = new Date(now); weekEnd.setDate(now.getDate() + 7);
  document.getElementById("statTotal").textContent = queue.length;
  var due = queue.filter(function(q) { return new Date(q.date + "T" + q.time) <= now; });
  var week = queue.filter(function(q) { var d = new Date(q.date + "T" + q.time); return d >= now && d <= weekEnd; });
  document.getElementById("statDue").textContent = due.length;
  document.getElementById("statWeek").textContent = week.length;
  if (!queue.length) {
    list.innerHTML = '<div class="empty"><div style="font-size:42px">&#x1F4CB;</div><p>No posts scheduled yet.<br/>Generate posts or use auto-fill!</p></div>';
    return;
  }
  var html = "";
  for (var i = 0; i < queue.length; i++) {
    var q = queue[i];
    var isDue = new Date(q.date + "T" + q.time) <= now;
    var preview = q.text.replace(/\n/g, " ").substring(0, 100) + (q.text.length > 100 ? "..." : "");
    html += '<div class="qi">';
    html += '<div class="qicon" style="background:' + IBGS[q.type] + '">' + ICONS[q.type] + '</div>';
    html += '<div class="qb">';
    html += '<span class="badge ' + BADGE[q.type] + '">' + q.type + '</span>';
    if (isDue) html += ' <span class="badge bdue">Due now</span>';
    html += '<div class="qp">' + preview + '</div>';
    html += '<div class="qt">&#x1F550; ' + fmtDate(q.date) + ' &middot; ' + q.time + '</div>';
    html += '<div class="qa"><button class="btn bc" onclick="copyQueueItem(' + q.id + ')">&#x2398; Copy</button></div>';
    html += '</div>';
    html += '<button class="qdel" onclick="removeFromQueue(' + q.id + ')">&times;</button>';
    html += '</div>';
  }
  list.innerHTML = html;
}

function generateWeek() {
  var defTime = document.getElementById("defaultTime") ? document.getElementById("defaultTime").value : "09:00";
  var today = new Date();
  showPanel("queue");
  document.getElementById("queueList").innerHTML = '<div class="empty"><div style="font-size:42px">&#x2726;</div><p>Generating 7 posts...<br/>About 30 seconds, hang tight!</p></div>';
  var i = 0;
  function genNext() {
    if (i >= 7) {
      queue.sort(function(a,b) { return (a.date+a.time).localeCompare(b.date+b.time); });
      renderQueue(); updateBadge();
      showStatus("queueStatus", "7 posts generated! Copy each into Meta Business Suite.", "success");
      return;
    }
    var d = new Date(today); d.setDate(today.getDate() + i);
    var ds = d.toISOString().split("T")[0];
    var type = CYCLE[i % CYCLE.length];
    fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      headers: { "Content-Type": "application/json",
    "x-api-key": "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",
    "anthropic-version": "2023-06-01",
    "anthropic-dangerous-direct-browser-access": "true" },
      body: JSON.stringify({ model: "claude-sonnet-4-20250514", max_tokens: 1000, system: SYS, messages: [{ role: "user", content: PROMPTS[type]("") }] })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (!data.error) {
        var text = data.content.map(function(b) { return b.text || ""; }).join("").trim();
        queue.push({ id: Date.now() + i, type: type, text: text, date: ds, time: defTime });
        queue.sort(function(a,b) { return (a.date+a.time).localeCompare(b.date+b.time); });
        renderQueue(); updateBadge();
      }
      i++; genNext();
    })
    .catch(function() { i++; genNext(); });
  }
  genNext();
}

function clearQueue() {
  if (!queue.length) return;
  if (confirm("Clear all scheduled posts?")) { queue = []; renderQueue(); updateBadge(); }
}

function updateBadge() {
  document.getElementById("queueBadge").textContent = queue.length;
}

function fmtDate(d) {
  return new Date(d + "T12:00:00").toLocaleDateString("en-GB", { weekday:"short", day:"numeric", month:"short" });
}

function showStatus(id, msg, type) {
  var el = document.getElementById(id);
  if (!el) return;
  el.className = "sb " + type;
  el.textContent = msg;
  el.style.display = "block";
}

function hideStatus(id) {
  var el = document.getElementById(id);
  if (el) el.style.display = "none";
}

function showStatus(id, msg, type) {
  var el = document.getElementById(id);
  if (!el) return;
  el.className = "sb " + type;
  el.textContent = msg;
  el.style.display = "block";
}

function saveAndTest() {
  var token = document.getElementById("fbToken").value.trim();
  var pageId = document.getElementById("fbPageId").value.trim();
  if (!token || !pageId) { showStatus("settingsStatus", "Please enter both token and page ID.", "error"); return; }
  showStatus("settingsStatus", "Testing connection...", "info");
  fetch("https://graph.facebook.com/v19.0/" + pageId + "?fields=name,fan_count&access_token=" + token)
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.error) throw new Error(d.error.message);
    var msg = "Connected to " + d.name + (d.fan_count ? " - " + d.fan_count.toLocaleString() + " followers" : "");
    showStatus("settingsStatus", msg, "success");
    var pill = document.getElementById("connPill");
    pill.className = "pill on";
    document.getElementById("connLabel").textContent = d.name || "Connected";
  })
  .catch(function(e) { showStatus("settingsStatus", "Failed: " + e.message, "error"); });
}

function shiftWeek(d) { calOff += d; renderCalendar(); }

function renderCalendar() {
  var today = new Date();
  var ws = new Date(today);
  ws.setDate(today.getDate() - ((today.getDay() + 6) % 7) + calOff * 7);
  var we = new Date(ws); we.setDate(ws.getDate() + 6);
  function fmt(d) { return d.toLocaleDateString("en-GB", { day:"numeric", month:"short" }); }
  document.getElementById("calRange").textContent = fmt(ws) + " - " + fmt(we);
  var days = ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];
  var html = "";
  for (var i = 0; i < 7; i++) html += '<div class="cdh">' + days[i] + '</div>';
  for (var i = 0; i < 7; i++) {
    var d = new Date(ws); d.setDate(ws.getDate() + i);
    var ds = d.toISOString().split("T")[0];
    var isToday = ds === today.toISOString().split("T")[0];
    var dp = queue.filter(function(q) { return q.date === ds; });
    var dots = dp.map(function(p) { return '<div class="cdot ' + p.type + '"></div>'; }).join("");
    html += '<div class="cc' + (dp.length ? " hp" : "") + (isToday ? " td" : "") + '">';
    html += '<div class="cn">' + d.getDate() + '</div>' + dots + '</div>';
  }
  document.getElementById("calGrid").innerHTML = html;
}

renderQueue();
renderCalendar();
</script>
